{
  "name": "markpic",
  "version": "2026.11.14",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/geekMus/MarkPic.git" },
  "description": "MarkPic：把 Markdown 里的图片收进图床（Go + 原生窗口 + Vue 3 界面，纯桌面程序）",
  "//": "任务入口：Node 脚本跨平台，真正的依赖在 web/package.json；需要 Node 20.19+。",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs --web",
    "build:go": "node scripts/build.mjs",
    "build:web": "node scripts/web.mjs",
    "typecheck": "node scripts/web.mjs --check",
    "test": "node scripts/test.mjs",
    "release": "node scripts/release.mjs"
  }
}