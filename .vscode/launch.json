{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "运行（图形界面）",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/markpic",
            "args": ["--no-open"]
        },
        {
            "name": "调试（命令行）",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/markpic",
            "args": ["--dry-run", "${input:targetPath}"]
        }
    ],
    "inputs": [
        {
            "id": "targetPath",
            "type": "promptString",
            "description": "要转换的 Markdown 文件或目录"
        }
    ]
}
