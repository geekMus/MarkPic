# Go 构建产物
/bin/
*.exe

# 本机用完的 Go 缓存与临时 HOME（构建验证时才建，别进仓库）
/.gocache/
/.gotmp/

# 程序运行数据（默认写在 exe 旁边的 data 目录，从仓库根直接跑时就会落在根上）
/data/

# 前端依赖（web/node_modules，根目录的 node_modules 由 pnpm 自动生成）
node_modules/

# Vite 改写配置时留下的临时目录（开发中改 vite.config.ts 可能出现）
web/.vite.config.ts.*.tmpdir/

# Playwright 等工具留下的临时文件
.playwright-mcp/

# 日志与编辑器缓存
*.log
.eslintcache

# 根目录只是任务入口（scripts/ 的快捷方式），不需要锁文件
/pnpm-lock.yaml

# 一次性截图/临时消息文件，别跟着代码进仓库
.tmp-*
.screenshots/

# nohup / 后台启动时留下的输出
nohup.out
